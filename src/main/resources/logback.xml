<configuration>
    <!-- Konsol logu -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Renkli, okunaklı format -->
            <pattern>%cyan(%d{HH:mm:ss}) %highlight([%level]) [%green(%class{0})] %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Günlük dosyası logu.
      ${servicio.baseDir} Launcher.main() tarafından (logback konfigüre olmadan ÖNCE) sistem
      özelliği olarak set edilir — bkz. tr.cabro.servicio.util.DataDirResolver. Özellik yoksa
      (ör. IDE'den doğrudan Servicio.main çalıştırılırsa) "." varsayılanı kullanılır (eski davranış).
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${servicio.baseDir:-.}/.servicio/logs/servicio.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${servicio.baseDir:-.}/.servicio/logs/log-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
